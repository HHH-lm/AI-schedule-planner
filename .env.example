# Supabase 配置（可选，不填则使用本地存储模式）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI 后端地址（开发默认 http://127.0.0.1:8000，由 scripts/dev.sh 自动启动）
BACKEND_URL=http://127.0.0.1:8000

# AI 解析服务（可选，不填则使用本地 NLP 规则）
# 用户自备 Key 模式：AI_PROVIDER 仅在请求未带 provider 时兜底（openai/deepseek/local，默认 local）；
# 服务端 OPENAI/DEEPSEEK_API_KEY 仅供 golden 评测链路使用，不服务线上用户请求
# （线上用户在应用设置页选择 OpenAI/DeepSeek 并填入自己的 Key）
AI_PROVIDER=

# AI 请求超时（毫秒，默认 15000，即 15 秒）
AI_TIMEOUT_MS=15000

# AI 单次输出 token 预算（默认 8000）。DeepSeek thinking 模式下思考与正文共享该预算：
# 过小会导致思考耗尽预算、正文为空（finish_reason=length，报「AI 输出被截断」）
MAX_OUTPUT_TOKENS=8000

# OpenAI（仅评测链路使用；线上用户在设置页自备 Key）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（可选，提供 Key 后自然语言解析走 DeepSeek API）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# thinking 开关（disabled/enabled，默认 disabled）：thinking 模式 effort 默认 high、
# 思考与正文共享输出预算，解析类任务关思考换速度；改回 enabled 须重跑 golden 验证质量
DEEPSEEK_THINKING=disabled

# 语音输入（可选，不填则两处输入框的麦克风按钮提示「语音输入暂不可用」）
# 服务端统一 Key：用户在应用内无需配置，只在这里配一次（本地 .env.local + Vercel 环境变量）
# SiliconFlow 免费模型、国内直连；注册：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
# ASR 模型与地址可配置。默认 TeleSpeechASR：2026-09-16 实测同音频交替对照，
# SenseVoiceSmall 延迟 0.6~31 秒剧烈波动（常触顶超时），TeleSpeechASR 稳定 0.2~1.6 秒
# 且中文识别结果相当；两者均免费，如需换回改本行即可
SILICONFLOW_ASR_MODEL=TeleAI/TeleSpeechASR
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 后端等待上游识别的最长时间（毫秒，默认 30000）。
# 前端上传超时（UPLOAD_TIMEOUT_MS=45s）刻意大于本值，好让后端的诊断文案先返回；
# 若调大本值，请同步调大前端 src/lib/api.ts 的 UPLOAD_TIMEOUT_MS
ASR_TIMEOUT_MS=30000
# 录音上限（默认 60 秒 / 8MB；前端按 16kHz 单声道 WAV 上传，60 秒约 1.9MB）
MAX_AUDIO_SECONDS=60
MAX_AUDIO_BYTES=8388608

# FastAPI 定时提醒（可选；需要 Supabase 云同步）
# SUPABASE_URL 与云同步同项目；SERVICE_ROLE_KEY 只放在后端，不下发浏览器
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REMINDER_SCAN_SECONDS=300
TIMEZONE=Asia/Shanghai

# 部署模式：自托管/本地保持 true；Vercel Serverless 必须设为 false，
# 改由 Vercel Cron 或外部定时器调用 GET /api/v1/reminders/cron
ENABLE_SCHEDULER=true

# 定时器鉴权（Serverless 模式必填）：Vercel Cron 自动以
# Authorization: Bearer <CRON_SECRET> 调用，建议 16 位以上随机串
CRON_SECRET=

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 微信推送通道：none / wecom / pushplus / serverchan
WECHAT_PUSH_TYPE=none
WECOM_WEBHOOK_URL=
PUSHPLUS_TOKEN=
SERVERCHAN_KEY=

# 后端结构化日志（默认 INFO/json，输出 JSON Lines 到 stdout）
LOG_LEVEL=INFO
LOG_FORMAT=json
# 运行环境标记（dev / prod，默认 dev；production/development 亦识别并归一化）：
# 写入每条日志的 env 字段，供 Axiom 监控按 env == 'prod' 过滤本地 pytest/dev 噪音
APP_ENV=dev

# Axiom 日志直发（可选；Hobby 版 Vercel 无 Log Drain，配置后应用内直发到 Axiom 免费版）
# token 用仅 ingest 权限的 API Token；两个值都配置后自动启用，LOG_SHIP_ENABLED=false 可紧急停发
# AXIOM_API_URL 是 ingest 专用边缘域名（api.axiom.co 会 404）：默认 US East 1，
# 组织所在区在 Axiom Settings → General → Edge deployment 查看（欧区改 eu-central-1.aws.edge.axiom.co）
AXIOM_API_URL=https://us-east-1.aws.edge.axiom.co
AXIOM_API_TOKEN=
AXIOM_DATASET=
LOG_SHIP_ENABLED=true
LOG_SHIP_TIMEOUT_SECONDS=2
