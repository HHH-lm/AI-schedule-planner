# Supabase 配置（可选，不填则使用本地存储模式）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI 后端地址（开发默认 http://127.0.0.1:8000，由 scripts/dev.sh 自动启动）
BACKEND_URL=http://127.0.0.1:8000

# AI 解析服务（可选，不填则使用本地 NLP 规则）
# AI_PROVIDER 可选值：auto / openai / deepseek / local，默认 auto
AI_PROVIDER=

# AI 请求超时（毫秒，默认 15000，即 15 秒）
AI_TIMEOUT_MS=15000

# OpenAI（可选，提供 Key 后自然语言解析走 OpenAI API）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（可选，提供 Key 后自然语言解析走 DeepSeek API）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# FastAPI 定时提醒（可选；需要 Supabase 云同步 + 常驻后端进程）
# SUPABASE_URL 与云同步同项目；SERVICE_ROLE_KEY 只放在后端，不下发浏览器
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REMINDER_SCAN_SECONDS=300
TIMEZONE=Asia/Shanghai

# 微信推送通道：none / wecom / pushplus / serverchan
WECHAT_PUSH_TYPE=none
WECOM_WEBHOOK_URL=
PUSHPLUS_TOKEN=
SERVERCHAN_KEY=

# 后端结构化日志（默认 INFO/json，输出 JSON Lines 到 stderr）
LOG_LEVEL=INFO
LOG_FORMAT=json
