{
  "name": "ai-schedule-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:raw": "next dev",
    "build": "bash scripts/check-dev-conflict.sh && next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "eval:ai:golden": "cd backend && .venv/bin/python -m app.eval_ai_golden",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
