[Unit]
Description=AI Schedule System FastAPI Backend
After=network.target

[Service]
User=deploy
WorkingDirectory=/opt/ai-schedule-system/backend
EnvironmentFile=/opt/ai-schedule-system/.env.local
ExecStart=/opt/ai-schedule-system/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
